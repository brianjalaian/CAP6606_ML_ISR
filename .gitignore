# Python virtual environments
.venv/

# Jupyter Book build outputs
_build/
.jupyter_cache/

# Python cache
__pycache__/
*.pyc

# Resources (copyrighted materials)
resource/

# Large data files (stay local only)
notebooks/*.csv
notebooks/*.parquet
notebooks/*.feather
notebooks/*.h5
notebooks/*.hdf5

# macOS
.DS_Store

# Environment variables (API keys, secrets — never commit)
.env
.env.*
!.env.example

# Claude Code local-only settings (may contain MCP API keys)
.claude/settings.local.json
.mcp.json

# Internal planning notes (never deployed)
PLAN.md

# Playwright MCP browser artifacts (screenshots, console logs)
.playwright-mcp/

# Slide debug screenshots dropped at repo root by Playwright MCP
# Always clean up after a slide-verification session
*.png
!assets/*.png
!modules/**/*.png

# Editor / IDE workspaces
.obsidian/
.vscode/
.idea/

# Local-only tooling and working files — this repo is PUBLIC.
# These are untracked by intent; listing them here stops `git add -A`
# from ever publishing them. `.codex/config.toml` holds a live API key.
scripts/
.codex/
tmp/
AGENTS.md
HANDOFF.md
