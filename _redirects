# Netlify Redirects & Role-Based Access Control
# Docs: https://docs.netlify.com/routing/redirects/role-based-access/

# Public pages - accessible to everyone
/index.html       /index.html       200
/login.html       /login.html       200
/promo.html       /promo.html       200

# Protected content - requires 'promo' or 'authenticated' role
/notebooks/*      /login.html       200!  Role=promo,authenticated
/modules/*        /login.html       200!  Role=promo,authenticated
/random-forests-tabular/*  /login.html  200!  Role=promo,authenticated
/ensemble-methods-tabular-data/*  /login.html  200!  Role=promo,authenticated

# API routes for functions
/.netlify/functions/*  /.netlify/functions/:splat  200

# Fallback
/*  /index.html  200
